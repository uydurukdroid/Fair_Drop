{
  "name": "fairdrop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1 --port 8313 --strictPort\"",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/db/migrate.ts",
    "doctor": "node --env-file-if-exists=.env --import tsx scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "usage:export": "node --env-file-if-exists=.env --import tsx scripts/usage-export.ts",
    "format:check": "prettier --check \"{web,server,shared,fixtures,tests,scripts}/**/*.{ts,tsx,css,json}\" \"*.{ts,json}\""
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@types/node": "26.6.0",
    "fastify": "5.12.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
